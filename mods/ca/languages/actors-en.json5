	"Actor-supportpower.fshield-Name": "Force Shield",
	"Actor-supportpower.fshield-Description": "Makes selected friendly structures temporarily invulnerable.\n\nWarning: Causes power failure.",
	"Actor-supportpower.sendcash-Name": "Send Cash",
	"Actor-supportpower.sendcash-Description": "Sends up to $1000 to the owner of the target allied unit or structure.\n\n20% is deducted from the amount received.",
	"Actor-supportpower.timeskip-Name": "Time Skip",
	"Actor-supportpower.timeskip-Description": "Allocate funding for precise temporal manipulation to progress Allied technological and organizational advancement.\n\nAdvances influence progress by 1:00.",
	"Actor-supportpower.veilofwar-Name": "Veil of War",
	"Actor-supportpower.veilofwar-Description": "Creates an expanding area of shroud, reducing the vision and weapon range of enemy units and defenses.",
	"Actor-supportpower.clustermine-Name": "Cluster Mines",
	"Actor-supportpower.clustermine-Description": "Sends a cargo plane to drop a minefield at the target location.",
	"Actor-supportpower.tempinc-Name": "Temporal Incursion",
	"Actor-supportpower.tempinc-Description": "Summons reinforcements from the future. Units return to their origin time after a short time.",
	"Actor-supportpower.strafe-Name": "Strafing Run",
	"Actor-supportpower.strafe-Description": "Calls in P51 ground attack planes to perform strafing runs on the target.",
	"Actor-supportpower.initialsatellitescanpower-Name": "Spy Satellite",
	"Actor-supportpower.initialsatellitescanpower-Description": "Periodically reveals the entire map for a short time (activated automatically).",
	"Actor-supportpower.satellitescanpower-Name": "Spy Satellite",
	"Actor-supportpower.satellitescanpower-Description": "Periodically reveals the entire map for a short time (activated automatically).",
	"Actor-supportpower.satellitescannofogpower-Name": "Spy Satellite",
	"Actor-supportpower.satellitescannofogpower-Description": "Permanently reveals the entire map (activated automatically).",
	"Actor-supportpower.timewarp-Name": "Time Warp",
	"Actor-supportpower.timewarp-Description": "Disrupts time and space at the target location. Affected units & structures are frozen in time, unable to act, but immune to damage.",
	"Actor-supportpower.cryostorm-Name": "Cryostorm",
	"Actor-supportpower.cryostorm-Description": "Creates a turbulent area of extreme cold, reducing movement speed and increasing damage taken.",
	"Actor-supportpower.heliosbomb-Name": "Helios Bomb",
	"Actor-supportpower.heliosbomb-Description": "Calls in a bomber which drops a Helios bomb, blinding units in a large area.",
	"Actor-supportpower.blackskystrike-Name": "Black Sky Strike",
	"Actor-supportpower.blackskystrike-Description": "Fires long range guided missiles at multiple ground targets prioritized by value. Tracking can be lost if targets move far enough from their initial location.",
	"Actor-supportpower.chronoshift-Name": "Chronoshift",
	"Actor-supportpower.chronoshift-Description": "Teleports up to 9 selected vehicles to a targeted location, returning them to their original location after a short time.\n\n• If killed, units are returned with 20% health\n• Units with larger health pools take additional damage\n• Passengers cannot be unloaded\n• Enemy units are teleported for reduced duration",
	"Actor-supportpower.chronoshiftai-Name": "Chronoshift",
	"Actor-supportpower.chronoshiftai-Description": "Teleports up to 9 selected vehicles to a targeted location, returning them to their original location after a short time.\n\n• If killed, units are returned with 20% health\n• Units with larger health pools take additional damage\n• Passengers cannot be unloaded\n• Enemy units are teleported for reduced duration",
	"Actor-supportpower.storm-Name": "Lightning Storm",
	"Actor-supportpower.storm-Description": "Initiate a Lightning Storm which deals heavy damage over a large area.",
	"Actor-supportpower.spyplane-Name": "Spy Plane",
	"Actor-supportpower.spyplane-Description": "Dispatches a spy plane that reveals the target location for a limited time.",
	"Actor-supportpower.paratroopers-Name": "Paratroopers",
	"Actor-supportpower.paratroopers-Description": "Dispatches a Halo transport to drop a squad of infantry anywhere on the map.",
	"Actor-supportpower.stormtroopers-Name": "Storm-troopers",
	"Actor-supportpower.stormtroopers-Description": "Dispatches a Halo transport to drop a squad of Shock Troopers anywhere on the map.",
	"Actor-supportpower.parabombs-Name": "Parabombs",
	"Actor-supportpower.parabombs-Description": "Calls in a Badger bomber which drops parachuted bombs on your target.",
	"Actor-supportpower.carpetbomb-Name": "Carpet Bomb",
	"Actor-supportpower.carpetbomb-Description": "Calls in a squad of Badgers which drop bombs on your target.",
	"Actor-supportpower.atombomb-Name": "Atomic Bomb",
	"Actor-supportpower.atombomb-Description": "Calls in a Badger bomber which drops an atom bomb on your target.",
	"Actor-supportpower.mutabomb-Name": "Genetic Mutation Bomb",
	"Actor-supportpower.mutabomb-Description": "Calls in a Badger bomber which drops a genetic mutation bomb on your target, transforming infantry into Brutes under your control.",
	"Actor-supportpower.chaosbombs-Name": "Chaos Bombs",
	"Actor-supportpower.chaosbombs-Description": "Calls in a Badger bomber which drops parachuted chaos bombs on your target.",
	"Actor-supportpower.atomicammo-Name": "Atomic Shells",
	"Actor-supportpower.atomicammo-Description": "Grants tanks a limited supply of atomic shells (also for a limited duration).\n\nAffects Soviet tanks only (Heavy/Rhino Tank, Lasher/Thrasher Tank, Siege Tank, Mammoth Tank, Overlord Tank, Apocalypse Tank, Nuke Cannon)\n\nNuke Cannon gains a neutron shell that kills vehicle crews.",
	"Actor-supportpower.atomicammoiraq-Name": "Atomic Shells",
	"Actor-supportpower.atomicammoiraq-Description": "Grants tanks a limited supply of atomic shells (also for a limited duration).\n\nAffects Soviet tanks only (Heavy/Rhino Tank, Lasher/Thrasher Tank, Siege Tank, Mammoth Tank, Overlord Tank, Apocalypse Tank, Nuke Cannon)\n\nNuke Cannon gains a neutron shell that kills vehicle crews.",
	"Actor-supportpower.heroesofunion-Name": "Heroes of the Union",
	"Actor-supportpower.heroesofunion-Description": "Targeted basic infantry units become Heroes of the Union, significantly increasing their damage, speed, range and resilience.\n\nCan affect Rifle Infantry, Rocket Soldiers, Grenadiers and Flamethrowers.",
	"Actor-supportpower.tankdrop-Name": "Tank Drop",
	"Actor-supportpower.tankdrop-Description": "Dispatches cargo planes to air drop tanks at the target location.",
	"Actor-supportpower.killzone-Name": "Kill Zone",
	"Actor-supportpower.killzone-Description": "Calls in a Spy Plane which marks a target area. Any enemy units within it take increased damage.",
	"Actor-supportpower.abomb-Name": "Atom Bomb",
	"Actor-supportpower.abomb-Description": "Launches a devastating atomic bomb at the target location, dealing heavy damage over a large area.",
	"Actor-supportpower.gdiuav-Name": "Recon Drone",
	"Actor-supportpower.gdiuav-Description": "A drone flies across the map, revealing the area as it passes.\n\nDetects cloaked units.",
	"Actor-supportpower.gdiuavarc-Name": "Recon Drone",
	"Actor-supportpower.gdiuavarc-Description": "A drone flies across the map, revealing the area as it passes.\n\nDetects cloaked units.",
	"Actor-supportpower.xodrop-Name": "X-O Drop",
	"Actor-supportpower.xodrop-Description": "An Orca transport drops a squad of X-O Powersuits at the target location.",
	"Actor-supportpower.droppods-Name": "Drop Pods",
	"Actor-supportpower.droppods-Description": "Instantly deploys a small team of elite soldiers at the target location via orbital drop pods.",
	"Actor-supportpower.dropzoneeagle-Name": "Reinforcements",
	"Actor-supportpower.dropzoneeagle-Description": "An Orca Carryall drops an APC containing an infantry squad at the target location.",
	"Actor-supportpower.interceptors-Name": "Interceptors",
	"Actor-supportpower.interceptors-Description": "A squadron of Interceptors provides air cover over the target area, engaging any enemy aircraft within range.",
	"Actor-supportpower.nrepair-Name": "Nanite Repair",
	"Actor-supportpower.nrepair-Description": "Repairs selected damaged vehicles over time.",
	"Actor-supportpower.rocketbarrage-Name": "Firestorm",
	"Actor-supportpower.rocketbarrage-Description": "Fires a barrage of rockets at the target area.",
	"Actor-supportpower.advradarorder-Name": "Advanced Radar Scan",
	"Actor-supportpower.advradarorder-Description": "Reveals the location of enemy structures & units through the fog of war.",
	"Actor-supportpower.nshieldorder-Name": "Nanite Shield",
	"Actor-supportpower.nshieldorder-Description": "Reduces the damage taken by all vehicles in the target area.",
	"Actor-supportpower.empmissile-Name": "E.M. Missile",
	"Actor-supportpower.empmissile-Description": "Fires a Tomahawk missile which disables all mechanical units and structures on impact.",
	"Actor-supportpower.surgicalstrike-Name": "Surgical Strike",
	"Actor-supportpower.surgicalstrike-Description": "Initiate an precision Ion Cannon strike which deals instant damage to a small area.",
	"Actor-supportpower.ioncannon-Name": "Ion Cannon",
	"Actor-supportpower.ioncannon-Description": "Initiate an Ion Cannon strike which deals heavy damage over a large area.",
	"Actor-supportpower.nodairdrop-Name": "Air Drop",
	"Actor-supportpower.nodairdrop-Description": "Dispatches cargo planes to air drop tanks at the target location.",
	"Actor-supportpower.blackhairdrop-Name": "Air Drop",
	"Actor-supportpower.blackhairdrop-Description": "Dispatches cargo planes to air drop flame tanks at the target location.",
	"Actor-supportpower.substrike-Name": "Subterranean Strike",
	"Actor-supportpower.substrike-Description": "Deploys a squad of Acolytes/Templar via Subterranean APC.",
	"Actor-supportpower.shadowairdrop-Name": "Air Drop",
	"Actor-supportpower.shadowairdrop-Description": "Dispatches cargo planes to air drop stealth tanks at the target location.",
	"Actor-supportpower.sathack-Name": "Hack Satellite Uplink",
	"Actor-supportpower.sathack-Description": "Reveals the targeted area for a short time.",
	"Actor-supportpower.sathacklegion-Name": "Hack Satellite Uplink",
	"Actor-supportpower.sathacklegion-Description": "Reveals the targeted area for a short time.",
	"Actor-supportpower.infernobomb-Name": "Inferno Bomb",
	"Actor-supportpower.infernobomb-Description": "A B2 Stealth Bomber drops inferno bombs on your target.",
	"Actor-supportpower.cashhack-Name": "Cash Hack",
	"Actor-supportpower.cashhack-Description": "Steal up to $2000 credits from a targeted enemy Refinery.",
	"Actor-supportpower.shadowteam-Name": "Shadow Team",
	"Actor-supportpower.shadowteam-Description": "Calls for a Shadow Team; three stealth infantry that arrive via glider armed with grenades and a machine pistol.\n\nOperatives can be ordered to land via the deploy command.",
	"Actor-supportpower.clustermissile-Name": "Cluster Missile",
	"Actor-supportpower.clustermissile-Description": "Launches a Cluster Missile which deals heavy damage at the target location.",
	"Actor-supportpower.frenzy-Name": "Frenzy",
	"Actor-supportpower.frenzy-Description": "Increases the movement speed and rate of fire of targeted units for a limited time.\n\nWarning: Units are weakened for a short time after frenzy wears off.",
	"Actor-supportpower.techhack-Name": "Technology Hack",
	"Actor-supportpower.techhack-Description": "Hack the targeted enemy production structure, providing access to a unit developed using enemy technology.\n\nFor infantry, vehicle and air production respectively: \n\n• Allies: Cryo Mortar, Reckoner, Phantom\n• Soviets: Cyberdog, Cyclops, Kamov\n• GDI: Sonic Mortar, Basilisk, Shade\n• Nod: Chem Mortar, Mantis, Vertigo\n• Scrin: Cyberscrin, Viper, Manticore",
	"Actor-supportpower.assassinsquad-Name": "Assassin Squad",
	"Actor-supportpower.assassinsquad-Description": "Deploy a squad of Assassins that can snipe infantry from long range and destroy buildings with C4.\n\nTarget infantry production structure to deploy.",
	"Actor-supportpower.assassinsquadai-Name": "Assassin Squad (AI)",
	"Actor-supportpower.assassinsquadai-Description": "Deploy a squad of Assassins that can destroy buildings and salvage technology.",
	"Actor-supportpower.hackercell-Name": "Hacker Cell",
	"Actor-supportpower.hackercell-Description": "Deploy a squad of Hackers that can remotely capture buildings and take control of defenses.\n\nTarget infantry production structure to deploy.",
	"Actor-supportpower.hackercellai-Name": "Hacker Cell (AI)",
	"Actor-supportpower.hackercellai-Description": "Deploy a squad of Hackers that can remotely capture buildings and take control of defenses.",
	"Actor-supportpower.confessorcabal-Name": "Confessor Cabal",
	"Actor-supportpower.confessorcabal-Description": "Deploy a Confessor Cabal which is able to construct Idols of Kane that buffs allies and debuffs enemies.\n\nTarget infantry production structure to deploy.",
	"Actor-supportpower.confessorcabalai-Name": "Confessor Cabal (AI)",
	"Actor-supportpower.confessorcabalai-Description": "Deploy a Confessor Cabal which is able to construct Idols of Kane that buffs allies and debuffs enemies.",
	"Actor-supportpower.stealthgen-Name": "Tiberium Stealth",
	"Actor-supportpower.stealthgen-Description": "Makes selected vehicles and structures temporarily invisible.\n\nWarning: Harmful to non-cyborg infantry.\n\nHazmat Suits upgrade makes allies immune to damage and enemies take 50% damage.",
	"Actor-supportpower.chemmissile-Name": "Chemical Missile",
	"Actor-supportpower.chemmissile-Description": "Launches an deadly Chemical Missile. Deals heavy damage and creates toxic clouds which are extremely harmful to infantry.\n",
	"Actor-supportpower.ichorspike-Name": "Ichor Spike",
	"Actor-supportpower.ichorspike-Description": "Creates an Ichor Spike at the target location. Resources within its area of influence grow and spread faster.\n\nAlso empowers units with Resource Conversion upgrade.",
	"Actor-supportpower.colonyspike-Name": "Colony Spike",
	"Actor-supportpower.colonyspike-Description": "Creates a Colony Spike at the target location. Enables production of non-defensive structures.\n\nWhen fully charged allows non-defensive structures to be built nearby.\n\nMust be built within range of a Colony Platform.",
	"Actor-supportpower.voidspike-Name": "Voidspike",
	"Actor-supportpower.voidspike-Description": "Creates a Voidspike at the target location. Gradually transforms nearby resources into Black Tiberium which is devoid of most of its useful properties.\n\nDamages nearby enemy units.",
	"Actor-supportpower.resourcescan-Name": "Resource Scan",
	"Actor-supportpower.resourcescan-Description": "Reveals the area surrounding all resources on the map.",
	"Actor-supportpower.stormspike-Name": "Storm Spike",
	"Actor-supportpower.stormspike-Description": "Creates a temporary Storm Column defensive structure at the target location.",
	"Actor-supportpower.buzzerswarm-Name": "Buzzer Swarm",
	"Actor-supportpower.buzzerswarm-Description": "Spawns a controllable swarm which blinds and damages anything nearby; particularly harmful to infantry.",
	"Actor-supportpower.buzzerswarmai-Name": "Buzzer Swarm (AI)",
	"Actor-supportpower.buzzerswarmai-Description": "Spawns a controllable swarm which damages anything nearby; particularly harmful to infantry.",
	"Actor-supportpower.ionsurge-Name": "Ion Surge",
	"Actor-supportpower.ionsurge-Description": "Increases the movement speed of all friendly units passing through the target area.",
	"Actor-supportpower.ichorseed-Name": "Ichor Seed",
	"Actor-supportpower.ichorseed-Description": "Grows Tiberium at selected location.",
	"Actor-supportpower.ichorseedreaper-Name": "Ichor Seed",
	"Actor-supportpower.ichorseedreaper-Description": "Grows Tiberium at selected location.",
	"Actor-supportpower.greatercoalescence-Name": "Greater Coalescence",
	"Actor-supportpower.greatercoalescence-Description": "Spawns a controllable biomass which heals nearby allies and sustains itself by feeding off enemies.\n\nFeeding from power plants will shut them down temporarily.",
	"Actor-supportpower.overlordswrath-Name": "Overlord's Wrath",
	"Actor-supportpower.overlordswrath-Description": "A Tiberium meteor strikes the target location dealing heavy damage and creating a patch of Tiberium.",
	"Actor-supportpower.gateway-Name": "Gateway",
	"Actor-supportpower.gateway-Description": "Creates a Gateway at the target location. Acts as the exit for any\n   targeted infantry or vehicle production structure.\n\nRequires target location to be within vision.",
	"Actor-supportpower.anathema-Name": "Anathema",
	"Actor-supportpower.anathema-Description": "Targeted vehicle greatly increases in power over time. After 30 seconds the unit explodes.",
