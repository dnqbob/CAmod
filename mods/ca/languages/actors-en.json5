	"Actor-encyclopedia.ifv.shad-EncyclopediaExtrasDescription": "IFV loaded with a Shadow Operative. Armed with a heavy machinegun and able to cloak.",
	"Actor-encyclopedia.ifv.shad-Name": "Shadow IFV",
	"Actor-encyclopedia.ifv.shad-Strengths": "• Strong vs Infantry, Light Armor",
	"Actor-encyclopedia.ifv.shad-Weaknesses": "• Weak vs Heavy Armor, Defenses\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.shard-Attributes": "• Passenger: Ravager, Eviscerator",
	"Actor-encyclopedia.ifv.shard-EncyclopediaExtrasDescription": "IFV loaded with a Ravager or Eviscerator. Fires Tiberium shards.",
	"Actor-encyclopedia.ifv.shard-Name": "Shard IFV",
	"Actor-encyclopedia.ifv.shard-Strengths": "• Strong vs Infantry, Light Armor",
	"Actor-encyclopedia.ifv.shard-Weaknesses": "• Weak vs Heavy Armor, Defenses, Buildings\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.snip-Attributes": "• Passenger: Sniper",
	"Actor-encyclopedia.ifv.snip-EncyclopediaExtrasDescription": "IFV loaded with a Sniper. Fires long-range sniper rounds.",
	"Actor-encyclopedia.ifv.snip-Name": "Sniper IFV",
	"Actor-encyclopedia.ifv.snip-Strengths": "• Strong vs Infantry, Light Armor, Heavy Armor",
	"Actor-encyclopedia.ifv.snip-Weaknesses": "• Weak vs Defenses, Buildings\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.spy-Attributes": "• Sabotages enemy structures:\\n    • Power Plants: Power outage\\n    • Barracks/Factory: Infantry/vehicles produced as veteran\\n    • Superweapons: Reset timer\\n    • Radar: Reset shroud\\n    • Helipad: Single-use paratroopers\\n    • Airfield/Gravity Stabilizer: Single-use airstrike\\n• Passenger: Spy",
	"Actor-encyclopedia.ifv.spy-EncyclopediaExtrasDescription": "IFV loaded with a Spy. Can sabotage enemy structures and detect cloaked units.",
	"Actor-encyclopedia.ifv.spy-Name": "Spy IFV",
	"Actor-encyclopedia.ifv.spy-Weaknesses": "• Cannot deal damage",
	"Actor-encyclopedia.ifv.stlk-Attributes": "• Passenger: Stalker",
	"Actor-encyclopedia.ifv.stlk-EncyclopediaExtrasDescription": "IFV loaded with a Stalker. Fires anti-infantry plasma darts and can cloak.",
	"Actor-encyclopedia.ifv.stlk-Name": "Stalker IFV",
	"Actor-encyclopedia.ifv.stlk-Strengths": "• Strong vs Light Armor, Infantry",
	"Actor-encyclopedia.ifv.stlk-Weaknesses": "• Weak vs Heavy Armor, Defenses\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.tes-Attributes": "• Passenger: Shock Trooper, Tesla Trooper",
	"Actor-encyclopedia.ifv.tes-EncyclopediaExtrasDescription": "IFV loaded with a Shock Trooper or Tesla Trooper. Fires a powerful tesla bolt.",
	"Actor-encyclopedia.ifv.tes-Name": "Tesla IFV",
	"Actor-encyclopedia.ifv.tes-Strengths": "• Strong vs Infantry, Heavy Armor, Light Armor",
	"Actor-encyclopedia.ifv.tes-Weaknesses": "• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.tigr-Attributes": "• Passenger: Tiger Guard",
	"Actor-encyclopedia.ifv.tigr-EncyclopediaExtrasDescription": "IFV loaded with a Tiger Guard. Fires long range missiles.",
	"Actor-encyclopedia.ifv.tigr-Name": "Tiger Guard IFV",
	"Actor-encyclopedia.ifv.tigr-Strengths": "• Strong vs Aircraft, Heavy Armor",
	"Actor-encyclopedia.ifv.tigr-Weaknesses": "• Weak vs Infantry",
	"Actor-encyclopedia.ifv.zdef-Attributes": "• Passenger: Zone Defender",
	"Actor-encyclopedia.ifv.zdef-EncyclopediaExtrasDescription": "IFV loaded with a Zone Defender. Fires ion blasts.",
	"Actor-encyclopedia.ifv.zdef-Name": "Zone Defender IFV",
	"Actor-encyclopedia.ifv.zdef-Strengths": "• Strong vs Heavy Armor, Light Armor, Defenses",
	"Actor-encyclopedia.ifv.zdef-Weaknesses": "• Weak vs Infantry, Buildings\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.zrai-Attributes": "• Passenger: Zone Raider",
	"Actor-encyclopedia.ifv.zrai-EncyclopediaExtrasDescription": "IFV loaded with a Zone Raider. Fires sonic grenades.",
	"Actor-encyclopedia.ifv.zrai-Name": "Zone Raider IFV",
	"Actor-encyclopedia.ifv.zrai-Strengths": "• Strong vs Light Armor, Buildings",
	"Actor-encyclopedia.ifv.zrai-Weaknesses": "• Cannot attack Aircraft",
	"Actor-encyclopedia.ifv.ztrp-Attributes": "• Passenger: Zone Trooper",
	"Actor-encyclopedia.ifv.ztrp-EncyclopediaExtrasDescription": "IFV loaded with a Zone Trooper. Fires powerful railgun shots.",
	"Actor-encyclopedia.ifv.ztrp-Name": "Zone Trooper IFV",
	"Actor-encyclopedia.ifv.ztrp-Strengths": "• Strong vs Heavy Armor, Light Armor, Defenses",
	"Actor-encyclopedia.ifv.ztrp-Weaknesses": "• Weak vs Infantry, Buildings\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.power.advancedradar-EncyclopediaExtrasAdditionalInfo": "Requires Seek & Destroy Strategy.",
	"Actor-encyclopedia.power.advancedradar-EncyclopediaExtrasDescription": "Reveals the location of enemy structures & units through the fog of war.",
	"Actor-encyclopedia.power.advancedradar-Name": "Advanced Radar",
	"Actor-encyclopedia.power.airdrop-EncyclopediaExtrasDescription": "Dispatches cargo planes to air drop tanks at the target location. Units dependent on subfaction.",
	"Actor-encyclopedia.power.airdrop-Name": "Air Drop",
	"Actor-encyclopedia.power.anathemapower-EncyclopediaExtrasAdditionalInfo": "Requires Malefic Allegiance.",
	"Actor-encyclopedia.power.anathemapower-EncyclopediaExtrasDescription": "Targeted vehicle greatly increases in power over time. After 30 seconds the unit explodes.",
	"Actor-encyclopedia.power.anathemapower-Name": "Anathema",
	"Actor-encyclopedia.power.assassinsquad-EncyclopediaExtrasAdditionalInfo": "Requires Wrath Covenant.",
	"Actor-encyclopedia.power.assassinsquad-EncyclopediaExtrasDescription": "Deploy a squad of Assassins that can snipe infantry from long range and destroy buildings with C4.\\n\\nTarget infantry production structure to deploy.",
	"Actor-encyclopedia.power.assassinsquad-Name": "Assassin Squad",
	"Actor-encyclopedia.power.atombomb-EncyclopediaExtrasDescription": "Launches a devastating atomic bomb at the target location, dealing heavy damage over a large area.",
	"Actor-encyclopedia.power.atombomb-Name": "Atom Bomb",
	"Actor-encyclopedia.power.atomicammo-EncyclopediaExtrasDescription": "Grants tanks a limited supply of atomic shells (also for a limited duration).\\n\\nAffects Soviet tanks only (Heavy/Rhino Tank, Lasher/Thrasher Tank, Siege Tank, Mammoth Tank, Overlord Tank, Apocalypse Tank, Nuke Cannon)",
	"Actor-encyclopedia.power.atomicammo-Name": "Atomic Shells",
	"Actor-encyclopedia.power.atomicbombair-EncyclopediaExtrasDescription": "Calls in a Badger bomber which drops an atom bomb on your target.",
	"Actor-encyclopedia.power.atomicbombair-Name": "Atomic Bomb (Air)",
	"Actor-encyclopedia.power.bsky-EncyclopediaExtrasAdditionalInfo": "Requires Korea Coalition.",
	"Actor-encyclopedia.power.bsky-EncyclopediaExtrasDescription": "Fires long range guided missiles at multiple ground targets prioritized by value. Tracking can be lost if targets move far enough from their initial location.",
	"Actor-encyclopedia.power.bsky-Name": "Black Sky Strike",
	"Actor-encyclopedia.power.buzzerswarm-EncyclopediaExtrasDescription": "Spawns a controllable swarm which blinds and damages anything nearby; particularly harmful to infantry.",
	"Actor-encyclopedia.power.buzzerswarm-Name": "Buzzer Swarm",
	"Actor-encyclopedia.power.carpetbomb-EncyclopediaExtrasDescription": "Calls in a squad of Badgers which drop bombs on your target.",
	"Actor-encyclopedia.power.carpetbomb-Name": "Carpet Bomb",
	"Actor-encyclopedia.power.cashhack-EncyclopediaExtrasDescription": "Steal up to $2000 credits from a targeted enemy Refinery.",
	"Actor-encyclopedia.power.cashhack-Name": "Cash Hack",
	"Actor-encyclopedia.power.chaosbombs-EncyclopediaExtrasDescription": "Calls in a Badger bomber which drops parachuted chaos bombs on your target.",
	"Actor-encyclopedia.power.chaosbombs-Name": "Chaos Bombs",
	"Actor-encyclopedia.power.chemmissile-EncyclopediaExtrasDescription": "Launches an deadly Chemical Missile. Deals heavy damage and creates toxic clouds which are extremely harmful to infantry.\\n",
	"Actor-encyclopedia.power.chemmissile-Name": "Chemical Missile",
	"Actor-encyclopedia.power.chronoshift-EncyclopediaExtrasDescription": "Teleports up to 9 selected vehicles to a targeted location, returning them to their original location after a short time.\\n\\n• If killed, units are returned with 20% health\\n• Units with larger health pools take additional damage\\n• Passengers cannot be unloaded\\n• Enemy units are teleported for reduced duration",
	"Actor-encyclopedia.power.chronoshift-Name": "Chronoshift",
	"Actor-encyclopedia.power.clustermines-EncyclopediaExtrasDescription": "Sends a cargo plane to drop a minefield at the target location.",
	"Actor-encyclopedia.power.clustermines-Name": "Cluster Mines",
	"Actor-encyclopedia.power.clustermissile-EncyclopediaExtrasDescription": "Launches a Cluster Missile which deals heavy damage at the target location.",
	"Actor-encyclopedia.power.clustermissile-Name": "Cluster Missile",
	"Actor-encyclopedia.power.colonyspike-EncyclopediaExtrasAdditionalInfo": "Requires Rebel Allegiance.",
	"Actor-encyclopedia.power.colonyspike-EncyclopediaExtrasDescription": "Creates a Colony Spike at the target location. Enables production of non-defensive structures.\\n\\nWhen fully charged allows non-defensive structures to be built nearby.\\n\\nMust be built within range of a Colony Platform.",
	"Actor-encyclopedia.power.colonyspike-Name": "Colony Spike",
	"Actor-encyclopedia.power.confessorcabal-EncyclopediaExtrasAdditionalInfo": "Requires Zeal Covenant.",
	"Actor-encyclopedia.power.confessorcabal-EncyclopediaExtrasDescription": "Deploy a Confessor Cabal which is able to construct Idols of Kane that buffs allies and debuffs enemies.\\n\\nTarget infantry production structure to deploy.",
	"Actor-encyclopedia.power.confessorcabal-Name": "Confessor Cabal",
	"Actor-encyclopedia.power.cryostorm-EncyclopediaExtrasAdditionalInfo": "Requires Sweden Coalition.",
	"Actor-encyclopedia.power.cryostorm-EncyclopediaExtrasDescription": "Creates a turbulent area of extreme cold, reducing movement speed and increasing damage taken.",
	"Actor-encyclopedia.power.cryostorm-Name": "Cryostorm",
	"Actor-encyclopedia.power.droppods-EncyclopediaExtrasDescription": "Instantly deploys a small team of elite soldiers at the target location via orbital drop pods.",
	"Actor-encyclopedia.power.droppods-Name": "Drop Pods",
	"Actor-encyclopedia.power.empmissile-EncyclopediaExtrasDescription": "Launches an EMP missile that disables vehicles and structures in the target area.",
	"Actor-encyclopedia.power.empmissile-Name": "EMP Missile",
	"Actor-encyclopedia.power.firestorm-EncyclopediaExtrasAdditionalInfo": "Requires Bombardment Strategy.",
	"Actor-encyclopedia.power.firestorm-EncyclopediaExtrasDescription": "Fires a barrage of rockets at the target area.",
	"Actor-encyclopedia.power.firestorm-Name": "Firestorm",
	"Actor-encyclopedia.power.fleetrecall-EncyclopediaExtrasDescription": "Recalls all selected Scrin fleet vessels back to the Signal Transmitter.\\n\\nApplies to: Mothership, Planetary Assault Carrier, Devastator",
	"Actor-encyclopedia.power.fleetrecall-Name": "Fleet Recall",
	"Actor-encyclopedia.power.forceshield-EncyclopediaExtrasDescription": "Makes selected friendly structures temporarily invulnerable.\\n\\nWarning: Causes power failure.",
	"Actor-encyclopedia.power.forceshield-Name": "Force Shield",
	"Actor-encyclopedia.power.frenzy-EncyclopediaExtrasDescription": "Increases the movement speed and rate of fire of targeted units for a limited time.\\n\\nWarning: Units are weakened for a short time after frenzy wears off.",
	"Actor-encyclopedia.power.frenzy-Name": "Frenzy",
	"Actor-encyclopedia.power.gateway-EncyclopediaExtrasAdditionalInfo": "Requires Rebel Allegiance.",
	"Actor-encyclopedia.power.gateway-EncyclopediaExtrasDescription": "Creates a Gateway at the target location. Acts as the exit for any\\n   targeted infantry or vehicle production structure.\\n\\nRequires target location to be within vision.",
	"Actor-encyclopedia.power.gateway-Name": "Gateway",
	"Actor-encyclopedia.power.greatercoalescence-EncyclopediaExtrasDescription": "Spawns a controllable biomass which heals nearby allies and sustains itself by feeding off enemies.\\n\\nFeeding from power plants will shut them down temporarily.",
	"Actor-encyclopedia.power.greatercoalescence-Name": "Greater Coalescence",
	"Actor-encyclopedia.power.hackercell-EncyclopediaExtrasAdditionalInfo": "Requires Unity Covenant.",
	"Actor-encyclopedia.power.hackercell-EncyclopediaExtrasDescription": "Deploy a squad of Hackers that can remotely capture buildings and take control of defenses.\\n\\nTarget infantry production structure to deploy.",
	"Actor-encyclopedia.power.hackercell-Name": "Hacker Cell",
	"Actor-encyclopedia.power.hacksat-EncyclopediaExtrasDescription": "Reveals the targeted area for a short time.",
	"Actor-encyclopedia.power.hacksat-Name": "Hack Satellite",
	"Actor-encyclopedia.power.heliosbomb-EncyclopediaExtrasAdditionalInfo": "Requires Greece Coalition.",
	"Actor-encyclopedia.power.heliosbomb-EncyclopediaExtrasDescription": "Calls in a bomber which drops a Helios bomb, blinding units in a large area.",
	"Actor-encyclopedia.power.heliosbomb-Name": "Helios Bomb",
	"Actor-encyclopedia.power.heroes-EncyclopediaExtrasAdditionalInfo": "Requires Infantry Doctrine.",
	"Actor-encyclopedia.power.heroes-EncyclopediaExtrasDescription": "Targeted basic infantry units become Heroes of the Union, significantly increasing their damage, speed, range and resilience.\\n\\nCan affect Rifle Infantry, Rocket Soldiers, Grenadiers and Flamethrowers.",
	"Actor-encyclopedia.power.heroes-Name": "Heroes of the Union",
	"Actor-encyclopedia.power.ichorseed-EncyclopediaExtrasDescription": "Grows Tiberium at selected location.",
	"Actor-encyclopedia.power.ichorseed-Name": "Ichor Seed",
	"Actor-encyclopedia.power.ichorspike-EncyclopediaExtrasAdditionalInfo": "Requires Loyalist Allegiance.",
	"Actor-encyclopedia.power.ichorspike-EncyclopediaExtrasDescription": "Creates an Ichor Spike at the target location. Resources within its area of influence grow and spread faster.\\n\\nAlso empowers units with Resource Conversion upgrade.",
	"Actor-encyclopedia.power.ichorspike-Name": "Ichor Spike",
	"Actor-encyclopedia.power.infbomb-EncyclopediaExtrasDescription": "A B2 Stealth Bomber drops inferno bombs on your target.",
	"Actor-encyclopedia.power.infbomb-Name": "Inferno Bomb",
	"Actor-encyclopedia.power.interceptors-EncyclopediaExtrasDescription": "A squadron of Interceptors provides air cover over the target area, engaging any enemy aircraft within range.",
	"Actor-encyclopedia.power.interceptors-Name": "Interceptors",
	"Actor-encyclopedia.power.ioncannon-EncyclopediaExtrasDescription": "Fires a devastating ion cannon beam at the target location.",
	"Actor-encyclopedia.power.ioncannon-Name": "Ion Cannon",
	"Actor-encyclopedia.power.ionsurge-EncyclopediaExtrasDescription": "Increases the movement speed of all friendly units passing through the target area.",
	"Actor-encyclopedia.power.ionsurge-Name": "Ion Surge",
	"Actor-encyclopedia.power.ironcurtain-EncyclopediaExtrasDescription": "Makes selected friendly vehicles temporarily invulnerable.",
	"Actor-encyclopedia.power.ironcurtain-Name": "Iron Curtain",
	"Actor-encyclopedia.power.killzone-EncyclopediaExtrasAdditionalInfo": "Requires Artillery Doctrine.",
	"Actor-encyclopedia.power.killzone-EncyclopediaExtrasDescription": "Calls in a Spy Plane which marks a target area. Any enemy units within it take increased damage.",
	"Actor-encyclopedia.power.killzone-Name": "Kill Zone",
	"Actor-encyclopedia.power.lightningstorm-EncyclopediaExtrasDescription": "Initiate a Lightning Storm which deals heavy damage over a large area.",
	"Actor-encyclopedia.power.lightningstorm-Name": "Lightning Storm",
	"Actor-encyclopedia.power.mutabomb-EncyclopediaExtrasDescription": "Calls in a Badger bomber which drops a genetic mutation bomb on your target, transforming infantry into Brutes under your control.",
	"Actor-encyclopedia.power.mutabomb-Name": "Muta Bomb",
	"Actor-encyclopedia.power.naniterepair-EncyclopediaExtrasDescription": "Repairs selected damaged vehicles over time.",
	"Actor-encyclopedia.power.naniterepair-Name": "Nanite Repair",
	"Actor-encyclopedia.power.naniteshield-EncyclopediaExtrasAdditionalInfo": "Requires Hold the Line Strategy.",
	"Actor-encyclopedia.power.naniteshield-EncyclopediaExtrasDescription": "Reduces the damage taken by all vehicles in the target area.",
	"Actor-encyclopedia.power.naniteshield-Name": "Nanite Shield",
	"Actor-encyclopedia.power.owrath-EncyclopediaExtrasAdditionalInfo": "Requires Loyalist Allegiance.",
	"Actor-encyclopedia.power.owrath-EncyclopediaExtrasDescription": "A Tiberium meteor strikes the target location dealing heavy damage and creating a patch of Tiberium.",
	"Actor-encyclopedia.power.owrath-Name": "Overlord's Wrath",
	"Actor-encyclopedia.power.parabombs-EncyclopediaExtrasDescription": "Calls in a Badger bomber which drops parachuted bombs on your target.",
	"Actor-encyclopedia.power.parabombs-Name": "Parabombs",
	"Actor-encyclopedia.power.paratroopers-EncyclopediaExtrasDescription": "Dispatches a Halo transport to drop a squad of infantry anywhere on the map.",
	"Actor-encyclopedia.power.paratroopers-Name": "Paratroopers",
	"Actor-encyclopedia.power.recondrone-EncyclopediaExtrasDescription": "A drone flies across the map, revealing the area as it passes.\\n\\nDetects cloaked units.",
	"Actor-encyclopedia.power.recondrone-Name": "Recon Drone",
	"Actor-encyclopedia.power.reinforcements-EncyclopediaExtrasDescription": "An Orca Carryall drops an APC containing an infantry squad at the target location.",
	"Actor-encyclopedia.power.reinforcements-Name": "Reinforcements",
	"Actor-encyclopedia.power.resourcescan-EncyclopediaExtrasDescription": "Reveals the area surrounding all resources on the map.",
	"Actor-encyclopedia.power.resourcescan-Name": "Resource Scan",
	"Actor-encyclopedia.power.rift-EncyclopediaExtrasDescription": "Initiate a Rift which deals heavy damage over time to a large area.",
	"Actor-encyclopedia.power.rift-Name": "Rift",
	"Actor-encyclopedia.power.sendcash-EncyclopediaExtrasDescription": "Available in team games and co-op. Sends $1000 credits to targeted ally.",
	"Actor-encyclopedia.power.sendcash-Name": "Send Cash",
	"Actor-encyclopedia.power.shadowteam-EncyclopediaExtrasDescription": "Calls for a Shadow Team; three stealth infantry that arrive via glider armed with grenades and a machine pistol.\\n\\nOperatives can be ordered to land via the deploy command.",
	"Actor-encyclopedia.power.shadowteam-Name": "Shadow Team",
	"Actor-encyclopedia.power.spyplane-EncyclopediaExtrasDescription": "Dispatches a spy plane that reveals the target location for a limited time.",
	"Actor-encyclopedia.power.spyplane-Name": "Spy Plane",
	"Actor-encyclopedia.power.spysatellite-EncyclopediaExtrasDescription": "Periodically reveals the entire map for a short time (activated automatically).",
	"Actor-encyclopedia.power.spysatellite-Name": "Spy Satellite",
	"Actor-encyclopedia.power.stormspikepower-EncyclopediaExtrasDescription": "Creates a temporary Storm Column defensive structure at the target location.",
	"Actor-encyclopedia.power.stormspikepower-Name": "Storm Spike",
	"Actor-encyclopedia.power.stormtroopers-EncyclopediaExtrasDescription": "Dispatches a Halo transport to drop a squad of Shock Troopers anywhere on the map.",
	"Actor-encyclopedia.power.stormtroopers-Name": "Storm-troopers",
	"Actor-encyclopedia.power.strafe-EncyclopediaExtrasDescription": "Calls in P51 ground attack planes to perform strafing runs on the target.",
	"Actor-encyclopedia.power.strafe-Name": "Strafing Run",
	"Actor-encyclopedia.power.substrike-EncyclopediaExtrasDescription": "Deploys a squad of infantry via Subterranean APC.",
	"Actor-encyclopedia.power.substrike-Name": "Subterranean Strike",
	"Actor-encyclopedia.power.suppression-EncyclopediaExtrasDescription": "Applies a suppression field to the target area, slowing unit movement and rate of fire.",
	"Actor-encyclopedia.power.suppression-Name": "Suppression",
	"Actor-encyclopedia.power.surgicalstrike-EncyclopediaExtrasDescription": "Initiate an precision Ion Cannon strike which deals instant damage to a small area.",
	"Actor-encyclopedia.power.surgicalstrike-Name": "Surgical Strike",
	"Actor-encyclopedia.power.tankdrop-EncyclopediaExtrasAdditionalInfo": "Requires Armor Doctrine.",
	"Actor-encyclopedia.power.tankdrop-EncyclopediaExtrasDescription": "Dispatches cargo planes to air drop tanks at the target location.",
	"Actor-encyclopedia.power.tankdrop-Name": "Tank Drop",
	"Actor-encyclopedia.power.techhack-EncyclopediaExtrasDescription": "Hack the targeted enemy production structure, providing access to a unit developed using enemy technology.\\n\\nFor infantry, vehicle and air production respectively: \\n\\n• Allies: Cryo Mortar, Reckoner, Phantom\\n• Soviets: Cyberdog, Cyclops, Kamov\\n• GDI: Sonic Mortar, Basilisk, Shade\\n• Nod: Chem Mortar, Mantis, Vertigo\\n• Scrin: Cyberscrin, Viper, Manticore",
	"Actor-encyclopedia.power.techhack-Name": "Tech Hack",
	"Actor-encyclopedia.power.tempinc-EncyclopediaExtrasDescription": "Summons reinforcements from the future. Units return to their origin time after a short time.",
	"Actor-encyclopedia.power.tempinc-Name": "Temporal Incursion",
	"Actor-encyclopedia.power.tibstealth-EncyclopediaExtrasDescription": "Makes selected vehicles and structures temporarily invisible.\\n\\nWarning: Harmful to non-cyborg infantry.\\n\\nHazmat Suits upgrade makes allies immune to damage and enemies take 50% damage.",
	"Actor-encyclopedia.power.tibstealth-Name": "Tiberium Stealth",
	"Actor-encyclopedia.power.timewarp-EncyclopediaExtrasDescription": "Disrupts time and space at the target location. Affected units & structures are frozen in time, unable to act, but immune to damage.",
	"Actor-encyclopedia.power.timewarp-Name": "Time Warp",
	"Actor-encyclopedia.power.veilofwar-EncyclopediaExtrasDescription": "Creates an expanding area of shroud, reducing the vision and weapon range of enemy units and defenses.",
	"Actor-encyclopedia.power.veilofwar-Name": "Veil of War",
	"Actor-encyclopedia.power.voidspike-EncyclopediaExtrasAdditionalInfo": "Requires Malefic Allegiance.",
	"Actor-encyclopedia.power.voidspike-EncyclopediaExtrasDescription": "Creates a Voidspike at the target location. Gradually transforms nearby resources into Black Tiberium which is devoid of most of its useful properties.\\n\\nDamages nearby enemy units.",
	"Actor-encyclopedia.power.voidspike-Name": "Voidspike",
	"Actor-encyclopedia.power.xodrop-EncyclopediaExtrasDescription": "An Orca transport drops a squad of X-O Powersuits at the target location.",
	"Actor-encyclopedia.power.xodrop-Name": "X-O Drop",
	"Actor-encyclopedia.reck.bh-Attributes": "• Passenger: Black Hand",
	"Actor-encyclopedia.reck.bh-EncyclopediaExtrasDescription": "Reckoner loaded with a Black Hand. Projects devastating anti-vehicle flames.",
	"Actor-encyclopedia.reck.bh-Name": "Black Hand Reckoner",
	"Actor-encyclopedia.reck.bh-Strengths": "• Strong vs Heavy Armor, Light Armor",
	"Actor-encyclopedia.reck.bh-Weaknesses": "• Weak vs Buildings, Defenses\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.reck.chem-Attributes": "• Passenger: Chem Warrior",
	"Actor-encyclopedia.reck.chem-EncyclopediaExtrasDescription": "Reckoner loaded with a Toxin Soldier. Sprays toxic chemicals.",
	"Actor-encyclopedia.reck.chem-Name": "Chemical Reckoner",
	"Actor-encyclopedia.reck.chem-Strengths": "• Strong vs Infantry, Light Armor, Buildings",
	"Actor-encyclopedia.reck.chem-Weaknesses": "• Weak vs Heavy Armor\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.reck.cmdo-Attributes": "• Passenger: Tanya, Boris, Commando",
	"Actor-encyclopedia.reck.cmdo-EncyclopediaExtrasDescription": "Reckoner loaded with a Commando (Tanya/Boris/Commando). Fires rapid and powerful sniper bursts with high damage per shot.",
	"Actor-encyclopedia.reck.cmdo-Name": "Commando Reckoner",
	"Actor-encyclopedia.reck.cmdo-Strengths": "• Strong vs Infantry",
	"Actor-encyclopedia.reck.cmdo-Weaknesses": "• Cannot attack Aircraft, Vehicles, Buildings",
	"Actor-encyclopedia.reck.cmsr-Attributes": "• Passenger: Commissar",
	"Actor-encyclopedia.reck.cmsr-EncyclopediaExtrasDescription": "Reckoner loaded with a Commissar. Inspires nearby friendly infantry, boosting their combat effectiveness.",
	"Actor-encyclopedia.reck.cmsr-Name": "Commissar Reckoner",
	"Actor-encyclopedia.reck.cmsr-Strengths": "Inspires nearby allies",
	"Actor-encyclopedia.reck.cmsr-Weaknesses": "Unarmed",
	"Actor-encyclopedia.reck.conf-Attributes": "• Explosion causes units to attack indiscriminately\\n• Passenger: Confessor",
	"Actor-encyclopedia.reck.conf-EncyclopediaExtrasDescription": "Reckoner loaded with a Confessor. Fires hallucinogenic rounds.",
	"Actor-encyclopedia.reck.conf-Name": "Confessor Reckoner",
	"Actor-encyclopedia.reck.conf-Strengths": "• Strong vs Infantry, Light Armor",
	"Actor-encyclopedia.reck.conf-Weaknesses": "• Weak vs Heavy Armor, Defenses, Buildings\\n• Cannot attack Aircraft",
	"Actor-encyclopedia.reck.cryo-Attributes": "• Slows enemy units and makes them take increased damage\\n• Passenger: Cryo Trooper",
